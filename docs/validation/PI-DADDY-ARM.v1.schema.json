{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mojomanyana/principal-pi-skills/docs/validation/PI-DADDY-ARM.v1.schema.json",
  "title": "Closed external-treatment arm policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "arm_id", "status", "measurement_eligible", "eligibility_reason",
    "executor", "producer", "pi_daddy", "result_contract", "attestation_contract",
    "accepted_attempt", "freshness_policy", "behavioral_evidence", "signing_keys",
    "canonical_definition_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "arm_id": { "$ref": "#/$defs/id" },
    "status": { "enum": ["experimental", "approved"] },
    "measurement_eligible": { "type": "boolean" },
    "eligibility_reason": { "type": "string", "minLength": 1 },
    "executor": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "identity"],
      "properties": {
        "kind": { "const": "subprocess" },
        "identity": { "$ref": "#/$defs/id" }
      }
    },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit", "tree", "artifact_sha256"],
      "properties": {
        "repository": { "type": "string", "format": "uri", "pattern": "^https://" },
        "commit": { "$ref": "#/$defs/gitOid" },
        "tree": { "$ref": "#/$defs/gitOid" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "pi_daddy": {
      "type": "object", "additionalProperties": false,
      "required": ["package_version", "package_sha256", "package_tree_sha256", "extension_sha256"],
      "properties": {
        "package_version": { "const": "0.19.0" },
        "package_sha256": { "$ref": "#/$defs/sha256" },
        "package_tree_sha256": { "$ref": "#/$defs/sha256" },
        "extension_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "result_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "schema_path", "encoding"],
      "properties": {
        "schema_version": { "const": 1 },
        "schema_path": { "const": "docs/validation/FUTURE-RESULT.v1.schema.json" },
        "encoding": { "const": "principal-canonical-json-v1" }
      }
    },
    "attestation_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "schema_path", "signature_algorithm"],
      "properties": {
        "schema_version": { "const": 1 },
        "schema_path": { "const": "docs/validation/EXTERNAL-ATTESTATION.v1.schema.json" },
        "signature_algorithm": { "const": "Ed25519" }
      }
    },
    "accepted_attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "cardinality", "index_origin", "required_status"],
      "properties": {
        "required": { "const": true },
        "cardinality": { "const": "exactly-one-per-observation" },
        "index_origin": { "const": 0 },
        "required_status": { "const": "completed" }
      }
    },
    "freshness_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["max_attestation_age_ms", "max_completion_to_attestation_ms"],
      "properties": {
        "max_attestation_age_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "max_completion_to_attestation_ms": { "type": "integer", "minimum": 0, "maximum": 300000 }
      }
    },
    "behavioral_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["required_types", "minimum_receipts"],
      "properties": {
        "required_types": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["delegation-completed"] }
        },
        "minimum_receipts": { "type": "integer", "minimum": 1 }
      }
    },
    "signing_keys": {
      "type": "array", "uniqueItems": true,
      "items": { "$ref": "#/$defs/signingKey" }
    },
    "canonical_definition_sha256": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": { "properties": { "measurement_eligible": { "const": true } }, "required": ["measurement_eligible"] },
      "then": {
        "properties": {
          "status": { "const": "approved" },
          "signing_keys": { "minItems": 1 }
        }
      },
      "else": { "properties": { "signing_keys": { "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitOid": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "signingKey": {
      "type": "object", "additionalProperties": false,
      "required": ["key_id", "fingerprint", "purpose", "active_from", "revoked_at"],
      "properties": {
        "key_id": { "$ref": "#/$defs/id" },
        "fingerprint": { "$ref": "#/$defs/sha256" },
        "purpose": { "enum": ["production", "test"] },
        "active_from": { "$ref": "#/$defs/timestamp" },
        "revoked_at": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }
      }
    }
  }
}

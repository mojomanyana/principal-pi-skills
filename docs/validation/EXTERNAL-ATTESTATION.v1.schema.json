{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mojomanyana/principal-pi-skills/docs/validation/EXTERNAL-ATTESTATION.v1.schema.json",
  "title": "External per-observation treatment attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attestation_id", "result_path", "result_file_sha256", "result_id", "scenario_id",
    "repetition_index", "accepted_attempt_id", "accepted_attempt_index", "arm_id", "arm_schema_version", "arm_definition_sha256",
    "producer_repository", "producer_commit", "producer_tree", "producer_artifact_sha256",
    "executor_identity", "run_id", "task_id", "workspace_id", "context_id", "ledger_sha256",
    "behavioral_receipt_sha256", "behavioral_evidence_types", "lifecycle", "observation_started_at", "observation_completed_at",
    "attested_at", "not_before", "expires_at", "nonce", "signing_key_id",
    "signing_key_fingerprint", "signing_key_purpose", "signature"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "attestation_id": { "$ref": "#/$defs/sha256" },
    "result_path": { "$ref": "#/$defs/relativePath" },
    "result_file_sha256": { "$ref": "#/$defs/sha256" },
    "result_id": { "$ref": "#/$defs/id" },
    "scenario_id": { "$ref": "#/$defs/id" },
    "repetition_index": { "type": "integer", "minimum": 0 },
    "accepted_attempt_id": { "$ref": "#/$defs/id" },
    "accepted_attempt_index": { "type": "integer", "minimum": 0 },
    "arm_id": { "$ref": "#/$defs/id" },
    "arm_schema_version": { "const": 1 },
    "arm_definition_sha256": { "$ref": "#/$defs/sha256" },
    "producer_repository": { "type": "string", "format": "uri", "pattern": "^https://" },
    "producer_commit": { "$ref": "#/$defs/gitOid" },
    "producer_tree": { "$ref": "#/$defs/gitOid" },
    "producer_artifact_sha256": { "$ref": "#/$defs/sha256" },
    "executor_identity": { "$ref": "#/$defs/id" },
    "run_id": { "$ref": "#/$defs/id" },
    "task_id": { "$ref": "#/$defs/id" },
    "workspace_id": { "$ref": "#/$defs/id" },
    "context_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "ledger_sha256": { "$ref": "#/$defs/sha256" },
    "behavioral_receipt_sha256": {
      "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" }
    },
    "behavioral_evidence_types": {
      "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["delegation-completed"] }
    },
    "capability_receipt_sha256": {
      "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "successful_delegation", "completed_children", "refusal_only"],
      "properties": {
        "status": { "const": "completed" },
        "successful_delegation": { "const": true },
        "completed_children": { "type": "integer", "minimum": 1 },
        "refusal_only": { "const": false }
      }
    },
    "observation_started_at": { "$ref": "#/$defs/timestamp" },
    "observation_completed_at": { "$ref": "#/$defs/timestamp" },
    "attested_at": { "$ref": "#/$defs/timestamp" },
    "not_before": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "nonce": { "type": "string", "minLength": 16, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$" },
    "signing_key_id": { "$ref": "#/$defs/id" },
    "signing_key_fingerprint": { "$ref": "#/$defs/sha256" },
    "signing_key_purpose": { "enum": ["production", "test"] },
    "signature": { "type": "string", "minLength": 88, "maxLength": 88, "pattern": "^[A-Za-z0-9+/]{86}==$" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitOid": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]*$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  }
}

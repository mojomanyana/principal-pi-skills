diff --git a/limit.mjs b/limit.mjs
index d7976c7ea93c557fd79862301fec7468ea395e16..e0050e1aa35ebe05eb43f4da4d8964de6969f264 100644
--- a/limit.mjs
+++ b/limit.mjs
@@ -1 +1 @@
-export const permit = count => count >= 0 && count <= 4;
+export const permit = count => Number.isInteger(count) && count >= 0 && count <= 3;
diff --git a/limit.test.mjs b/limit.test.mjs
index 9f75562111f7b5d63ae691e0f8871251f564ef77..6e0b6e3e11e964324b88e32b3dad08b61ee4e091 100644
--- a/limit.test.mjs
+++ b/limit.test.mjs
@@ -1,4 +1,19 @@
 import test from 'node:test';
 import assert from 'node:assert/strict';
 import { permit } from './limit.mjs';
-test('existing happy path only', () => { assert.equal(permit(0), true); assert.equal(permit(3), true); });
+test('permits integer Count values from 0 through 3 inclusive', () => {
+  assert.equal(permit(0), true);
+  assert.equal(permit(3), true);
+});
+
+test('rejects values outside the inclusive range', () => {
+  assert.equal(permit(-1), false);
+  assert.equal(permit(4), false);
+});
+
+test('rejects malformed inputs without coercion', () => {
+  assert.equal(permit('2'), false);
+  assert.equal(permit(null), false);
+  assert.equal(permit(Number.NaN), false);
+  assert.equal(permit(1.5), false);
+});

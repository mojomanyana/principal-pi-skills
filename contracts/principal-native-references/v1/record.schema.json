{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mojomanyana/principal-pi-skills/contracts/principal-native-references/v1/record.schema.json",
  "description": "Explicit Principal native reference records; structural declarations, never authenticated approval or gate effects.",
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["seq", "digest"],
      "properties": { "seq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "digest": { "$ref": "#/$defs/digest" } }
    }
  },
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["type", "check_id", "task", "context", "candidate", "evidence", "evidence_sha256", "corrects", "author"],
      "properties": {
        "type": { "const": "check-result" }, "check_id": { "$ref": "#/$defs/id" }, "author": { "$ref": "#/$defs/id" },
        "task": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/ref" }] }, "context": { "$ref": "#/$defs/ref" }, "candidate": { "$ref": "#/$defs/ref" },
        "evidence": { "$ref": "#/$defs/ref" }, "evidence_sha256": { "$ref": "#/$defs/digest" },
        "corrects": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/ref" }] }
      }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "check_id", "previous", "reason", "author"],
      "properties": {
        "type": { "const": "check-retired" }, "check_id": { "$ref": "#/$defs/id" }, "author": { "$ref": "#/$defs/id" },
        "previous": { "$ref": "#/$defs/ref" }, "reason": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\S" }
      }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["type", "native_finalization", "checks", "author"],
      "properties": {
        "type": { "const": "finalization-linked" }, "author": { "$ref": "#/$defs/id" },
        "native_finalization": { "$ref": "#/$defs/ref" },
        "checks": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } }
      }
    }
  ]
}

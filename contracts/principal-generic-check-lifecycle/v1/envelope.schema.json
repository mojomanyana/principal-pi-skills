{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://principal-pi-skills.local/contracts/principal-generic-check-lifecycle/v1/envelope.schema.json",
  "title": "Principal generic check lifecycle export v1 (not work acceptance)",
  "type": "object", "additionalProperties": false,
  "required": ["version", "authority", "acceptance", "source", "association", "emissions", "digest"],
  "properties": {
    "version": { "const": "principal-generic-check-lifecycle-v1" },
    "authority": { "const": "declared-not-authenticated" }, "acceptance": { "const": "not-assessed" },
    "digest": { "$ref": "#/$defs/sha" }, "source": { "$ref": "#/$defs/source" },
    "association": { "type": "object", "required": ["version", "readOnly", "acceptance", "native_references", "associations"], "properties": {
      "version": { "const": "principal-work-associations-v3" }, "readOnly": { "const": true }, "acceptance": { "const": "not-assessed" },
      "native_references": { "type": "object" }, "associations": { "type": "array", "maxItems": 256 }
    } },
    "emissions": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/emission" } }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "ref": { "type": "object", "additionalProperties": false, "required": ["seq", "digest"], "properties": {
      "seq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "digest": { "$ref": "#/$defs/sha" }
    } },
    "nullableRef": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/ref" }] },
    "source": { "type": "object", "additionalProperties": false,
      "required": ["native_ledger", "journal_head", "journal_sha256", "association_sha256", "daily_view_sha256", "bindings_sha256", "work_context_sha256"],
      "properties": {
        "native_ledger": { "type": "object", "additionalProperties": false, "required": ["run_id", "event_count", "hash_chain_head"], "properties": {
          "run_id": { "$ref": "#/$defs/id" }, "event_count": { "type": "integer", "minimum": 1, "maximum": 10000 }, "hash_chain_head": { "$ref": "#/$defs/sha" }
        } },
        "journal_head": { "$ref": "#/$defs/nullableRef" }, "journal_sha256": { "$ref": "#/$defs/sha" },
        "association_sha256": { "$ref": "#/$defs/sha" }, "daily_view_sha256": { "$ref": "#/$defs/sha" }, "bindings_sha256": { "$ref": "#/$defs/sha" },
        "work_context_sha256": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha" }] }
      }
    },
    "receipt": { "type": "object", "additionalProperties": false,
      "required": ["version", "archive_id", "object_id", "sha256", "byte_length", "origin_sha256"],
      "properties": {
        "version": { "const": "principal-check-payload-receipt-v1" }, "archive_id": { "$ref": "#/$defs/id" }, "object_id": { "$ref": "#/$defs/id" },
        "sha256": { "$ref": "#/$defs/sha" }, "byte_length": { "type": "integer", "minimum": 0, "maximum": 1048576 }, "origin_sha256": { "$ref": "#/$defs/sha" }
      }
    },
    "payload": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["state", "reason"], "properties": {
        "state": { "enum": ["missing", "unbound"] }, "reason": { "enum": ["bytes-not-supplied", "source-unavailable", "source-permission-missing", "archive-port-missing", "work-link-unbound"] }
      } },
      { "type": "object", "additionalProperties": false, "required": ["state", "permission_id", "sha256", "byte_length", "origin", "receipt", "readback_sha256"], "properties": {
        "state": { "const": "retained" }, "permission_id": { "$ref": "#/$defs/id" }, "sha256": { "$ref": "#/$defs/sha" }, "readback_sha256": { "$ref": "#/$defs/sha" },
        "byte_length": { "type": "integer", "minimum": 0, "maximum": 1048576 }, "origin": { "type": "object" }, "receipt": { "$ref": "#/$defs/receipt" }
      } }
    ] },
    "retirement": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["state"], "properties": { "state": { "enum": ["not-retired", "unbound"] } } },
      { "type": "object", "additionalProperties": false, "required": ["state", "origin", "previous", "reason"], "properties": {
        "state": { "const": "emitted" }, "origin": { "$ref": "#/$defs/ref" }, "previous": { "$ref": "#/$defs/ref" }, "reason": { "type": "string", "minLength": 1, "maxLength": 2048 }
      } }
    ] },
    "emission": { "type": "object", "additionalProperties": false,
      "required": ["binding_id", "run_id", "check_id", "revision", "predecessor", "state", "applicability", "relation", "acceptance", "work", "native", "finalization", "retirement", "issues", "payloads"],
      "properties": {
        "binding_id": { "$ref": "#/$defs/id" }, "run_id": { "$ref": "#/$defs/id" }, "check_id": { "$ref": "#/$defs/id" }, "revision": { "$ref": "#/$defs/ref" }, "predecessor": { "$ref": "#/$defs/nullableRef" },
        "state": { "enum": ["emitted", "unbound", "error"] }, "applicability": { "enum": ["current", "stale", "superseded", "retired", "unbound", "error"] },
        "relation": { "const": "explicit-reference-link-not-semantic-equivalence" }, "acceptance": { "const": "not-assessed" },
        "work": { "type": ["null", "object"] }, "native": { "type": ["null", "object"] }, "finalization": { "type": ["null", "object"] }, "retirement": { "$ref": "#/$defs/retirement" },
        "issues": { "type": "array", "items": { "type": "string" } },
        "payloads": { "type": "object", "additionalProperties": false, "required": ["stdout", "stderr", "output"], "properties": { "stdout": { "$ref": "#/$defs/payload" }, "stderr": { "$ref": "#/$defs/payload" }, "output": { "$ref": "#/$defs/payload" } } }
      }
    }
  }
}

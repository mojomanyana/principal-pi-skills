{
  "name": "principal-pi-skills",
  "version": "6.1.0",
  "description": "Five core principal engineering skills (architect, build, review, debug, git-ops) and passive Pi 1.6 verification/routing extensions.",
  "license": "MIT",
  "author": "Nemanja Alavanja",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojomanyana/principal-pi-skills.git"
  },
  "homepage": "https://github.com/mojomanyana/principal-pi-skills#readme",
  "bugs": {
    "url": "https://github.com/mojomanyana/principal-pi-skills/issues"
  },
  "keywords": [
    "pi-package",
    "skills",
    "agent-skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run generate:check && npm run test:unit && npm run test:install && npm run check:pack && npm run lint:skills",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "generate": "node scripts/generate-contracts.mjs",
    "generate:check": "node scripts/generate-contracts.mjs --check",
    "lint:skills": "node scripts/lint-skills.mjs",
    "test:install": "node --test tests/install/*.test.mjs",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "pi": {
    "skills": [
      "./architect",
      "./build",
      "./review",
      "./debug",
      "./git-ops",
      "./plan",
      "./investigate",
      "./review-security",
      "./review-perf",
      "./test-engineer",
      "./orchestrator",
      "./refactor"
    ],
    "prompts": [
      "./prompts"
    ],
    "extensions": [
      "./extensions/bootstrap.ts",
      "./extensions/verify-before-settle.ts"
    ]
  },
  "bin": {
    "principal-pi-agents": "./scripts/install-agents.mjs",
    "principal-pi-workspace": "./scripts/snapshot-workspace.mjs",
    "principal-pi-check": "./scripts/check-runner.mjs"
  },
  "files": [
    "AGENTS.md",
    "principal-agents.json",
    "CHANGELOG.md",
    "architect/SKILL.md",
    "build/SKILL.md",
    "review/SKILL.md",
    "debug/SKILL.md",
    "git-ops/SKILL.md",
    "plan/SKILL.md",
    "investigate/SKILL.md",
    "review-security/SKILL.md",
    "review-perf/SKILL.md",
    "test-engineer/SKILL.md",
    "orchestrator/SKILL.md",
    "refactor/SKILL.md",
    "prompts/*.md",
    "agents/*.md",
    "scripts/install-agents.mjs",
    "scripts/snapshot-workspace.mjs",
    "scripts/check-runner.mjs",
    "extensions/bootstrap.ts",
    "extensions/verify-before-settle.ts",
    "bootstrap/BOOTSTRAP.md",
    "references/research.md",
    "references/checkpoints.md",
    "review/references/test-quality.md"
  ],
  "devDependencies": {},
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
